--- worker -- Web Worker bindings over the `js` interop ops.
---
--- Parent side: `spawn` constructs a `Worker` through `js.construct`,
--- `post_message`/`terminate` dispatch through `js.invoke`, and
--- `on_message` registers a Handl arrow for the worker's `"message"`
--- events — the `js.on` trampoline unwraps `MessageEvent.data` on DOM
--- EventTargets (browser `Worker`) and takes the emit argument
--- verbatim on EventEmitters (Node `worker_threads` `Worker`), awaits
--- the arrow, and posts a non-null result back to the worker.
---
--- NOTE: codegen now emits the dispatch forms this module hand-rolls —
--- `handl-packages/generated/html*/Worker_c.hnl` (and
--- `DedicatedWorkerGlobalScope_c.hnl`, `SharedWorker_c.hnl`,
--- `MessagePort_c.hnl`, `BroadcastChannel_c.hnl`, …) carry
--- `js.construct`/`js.invoke`/`js.on` adapters with `Result<_, JsError>`
--- returns and an explicit `self: Handle` receiver. This module stays
--- the ergonomic `js/worker` surface because the generated bindings do
--- NOT cover: `spawn_code`/`revoke_object_url` (Blob + object-URL
--- composition), the `on`/`off` generic event helpers, the
--- null-return + `js.error()` convention, or the worker-side `self`
--- global resolved by name (`self_post_message`/`on_message_self`/
--- `self_close` — the generated `DedicatedWorkerGlobalScope_*` ports
--- take `self` as an explicit Handle argument instead).
---
--- Worker side (the compiled entry running inside a worker global
--- scope): `self_post_message` replies to the parent,
--- `on_message_self` handles incoming messages, and `self_close`
--- terminates the worker. The peer is resolved by `self_target`:
--- the `self` global (`DedicatedWorkerGlobalScope`) on web hosts,
--- `worker_threads.parentPort` on Node — `globalThis` inside a Node
--- worker has no `self`/`postMessage`, the `MessagePort` is the real
--- channel (an EventEmitter for `js.on`, an `isPeer` reply target).
---
--- Node.js shim: browsers/Deno/Bun expose `Worker` on `globalThis`;
--- Node keeps it in `worker_threads` only, so `js.construct` cannot
--- reach it. `spawn` runs `ensure_worker_global` first, which installs
--- `globalThis.Worker` once on Node via `js.get`/`js.invoke`/`js.set`
--- (the `typeof` probes became property reads; the
--- `process.getBuiltinModule` fast path is a plain `invoke` + `set`).
--- The awaited dynamic `import('worker_threads')` fallback for old
--- Node goes through `js.import_module` — the contract's dynamic
--- `import(spec)` op — settled by `js.await` into the `Result` whose
--- `ok` value is the module namespace. No `eval` anywhere.
---
--- Transfer lists: `post_message`/`self_post_message` take an optional
--- `transfer` array. WebIDL `postMessage(message, options)` carries it
--- as `{ transfer: [...] }` (StructuredSerializeOptions); Node's
--- `worker_threads` `postMessage(value, transferList)` wants the bare
--- array, so the call branches on the Node probe.
---
--- Import as `from "js/worker" import { spawn, post_message, … }`
--- (the `js = { path = "…/lib-js/src" }` dep already covers it) or via
--- a `worker = { path = "…/lib-js/src/worker" }` dep.
---
--- Failure convention: every op returns `null` and records the JS
--- exception for `js.error()` when `throws` is false — check
--- `error()` after a `null` result exactly as with `js.call`.

from "js" import {
  await as js_await,
  call as js_call,
  construct as js_construct,
  error as js_error,
  invoke as js_invoke,
  import_module as js_import_module,
  off as js_off,
  on as js_on,
  get as js_get,
  set as js_set,
}

--- True on Node.js (`process.versions.node` is set). Probed with
--- `js.get` — `globalThis.process` resolves to `null` where no `process`
--- global exists, and `versions.node` reads the version string.
node_runtime := () ~> do {
  p := js_get("globalThis", "process")
  if p == null {
    false
  } else {
    n := js_get(p, "versions.node")
    n != null
  }
}

--- Synchronous `worker_threads` install via
--- `process.getBuiltinModule('worker_threads')` (Node ≥ 20.16 /
--- ≥ 22.3): invoke the builtin loader, read `Worker` off the module,
--- and `js.set` it on `globalThis`. Returns `true` on success, `false`
--- when the fast path is unavailable or fails.
install_worker_builtin := () ~> do {
  p := js_get("globalThis", "process")
  if p == null {
    false
  } else {
    m := js_invoke(p, "getBuiltinModule", ["worker_threads"], [], "js_object", false)
    if m == null {
      false
    } else {
      w := js_get(m, "Worker")
      if w == null {
        false
      } else {
        s := js_set("globalThis", "Worker", w)
        s != null
      }
    }
  }
}

--- Ensure `globalThis.Worker` resolves. Browsers/Deno/Bun already
--- expose it (returns `true` without touching anything); on Node the
--- `worker_threads` export is installed once — synchronously via
--- `install_worker_builtin` (Node ≥ 20.16 / ≥ 22.3), falling back to
--- an awaited dynamic `import('worker_threads')` on older Node.
--- Returns whether `Worker` is a global afterwards; `false` on
--- non-Node hosts without it or when the install fails.
ensure_worker_global := () ~> do {
  has := js_get("globalThis", "Worker")
  if has != null {
    true
  } else if node_runtime() != true {
    false
  } else {
    installed := install_worker_builtin()
    if installed == true {
      true
    } else {
      --- Old Node without `process.getBuiltinModule`: the awaited
      --- dynamic `import('worker_threads')` runs through the contract's
      --- `js.import_module` op — `js.await` settles the namespace
      --- promise into a `Result` (`ok` carries the module record, so
      --- `value` is the namespace on success and the JsError on `err`).
      p := js_import_module("worker_threads")
      r := js_await(p)
      ns := js_get(r, "value")
      w := js_get(ns, "Worker")
      if w == null {
        false
      } else {
        s := js_set("globalThis", "Worker", w)
        s != null
      }
    }
  }
}

--- Resolve the worker-side message peer. Web worker globals expose
--- `self` (`DedicatedWorkerGlobalScope`), returned here as the global
--- NAME so `js.call`/`js.on` resolve it the usual way. Node
--- `worker_threads` workers have no `self`/`postMessage` on
--- `globalThis` — the channel is the `worker_threads` module's
--- `parentPort` (a `MessagePort`: an EventEmitter for `js.on`'s
--- emitter path AND an `isPeer` reply target, so a `"message"` arrow's
--- non-null result posts back to the parent automatically). Node
--- resolution mirrors `install_worker_builtin`: the synchronous
--- `process.getBuiltinModule('worker_threads')` fast path first
--- (Node ≥ 20.16 / ≥ 22.3), then the awaited dynamic
--- `import('worker_threads')` for older Node. Returns the `parentPort`
--- object on Node, `"self"` on web hosts, or `null` when no peer
--- exists (e.g. `parentPort` is `null` on the Node main thread —
--- callers surface that through `js.error()` like any failed op).
export self_target := () ~> do {
  if node_runtime() != true {
    "self"
  } else {
    p := js_get("globalThis", "process")
    m := if p == null {
      null
    } else {
      js_invoke(p, "getBuiltinModule", ["worker_threads"], [], "js_object", false)
    }
    port := if m == null { null } else { js_get(m, "parentPort") }
    if port != null {
      port
    } else {
      r := js_await(js_import_module("worker_threads"))
      ns := js_get(r, "value")
      pp := if ns == null { null } else { js_get(ns, "parentPort") }
      if pp == null { null } else { pp }
    }
  }
}

--- Spawn a `Worker` for `url` (a script URL — `blob:` URLs from
--- `spawn_code` work too).
--- @details
--- `opts` is the WebIDL `WorkerOptions` record (`{ type: "module",
--- name: "…" }`); pass `null` for the defaults. Returns the Worker
--- object, or `null` with `js.error()` set on failure (e.g. a
--- cross-origin URL the CSP refuses).
export spawn := (url, opts) ~> do {
  _ := ensure_worker_global()
  if opts == null {
    js_construct("", "Worker", [url], [], "js_object", false)
  } else {
    js_construct("", "Worker", [url, opts], [], "js_object", false)
  }
}

--- Spawn a `Worker` from inline `code` via a `Blob` object URL.
--- @details
--- Builds `new Blob([code])`, resolves `URL.createObjectURL`, and
--- delegates to `spawn`. The object URL is NOT revoked automatically —
--- call `revoke_object_url` once the worker has loaded if the code is
--- large or spawned repeatedly. On Node `worker_threads` there is no
--- `blob:` Worker URL — the code runs through
--- `new Worker(code, { eval: true })` instead (no object URL is
--- minted, so `revoke_object_url` is a no-op there). Returns the
--- Worker object or `null` (with `js.error()` set) on failure.
export spawn_code := (code, opts) ~> do {
  if node_runtime() == true {
    _ := ensure_worker_global()
    --- Node `worker_threads` has no `Blob` object-URL scripts — a
    --- `blob:` specifier is not a supported Worker URL. The Node
    --- equivalent is `new Worker(code, { eval: true })`, which runs
    --- `code` as the entry source. `eval` is merged into `opts` on
    --- the JS side (`Object.assign` + `js.set`) because Handl records
    --- have no spread; unknown WebIDL keys (`type`, `name`) are
    --- ignored by Node's option parser. `Object.assign` skips a
    --- `null` source, so `opts == null` needs no special case.
    o := js_call("Object", "assign", [{}, opts], [], "js_object", false)
    e1 := js_error()
    --- `js.set` returns the assigned value (`true`), not the target —
    --- `o` is the options object either way; `s == null` is the
    --- failure signal.
    s := if e1 == null { js_set(o, "eval", true) } else { null }
    e2 := js_error()
    if s == null {
      null
    } else {
      js_construct("", "Worker", [code, o], [], "js_object", false)
    }
  } else {
    blob := js_construct("", "Blob", [[code]], [], "js_object", false)
    e1 := js_error()
    url := if e1 == null {
      js_call("URL", "createObjectURL", [blob], [], "js_string", false)
    } else { null }
    e2 := js_error()
    if e2 == null { spawn(url, opts) } else { null }
  }
}

--- Revoke an object URL minted by `spawn_code`/`URL.createObjectURL`.
export revoke_object_url := (url) ~>
  js_call("URL", "revokeObjectURL", [url], [], "void", false)

--- Post `msg` to `worker` (`worker.postMessage`).
--- @details
--- `transfer` is the optional structured-clone transfer list (a Handl
--- array of transferable objects — `ArrayBuffer`s, `MessagePort`s);
--- pass `null` for none. The message must be structured-cloneable:
--- Handl's `__pair__`/`__either__`/`__bytes__`/tag records survive the
--- clone, arrows/promises/`__resource__` handles do not.
--- On web hosts the list rides the WebIDL options record
--- (`postMessage(msg, { transfer })`); on Node `worker_threads` wants
--- the bare array (`postMessage(value, transferList)`), so the call
--- branches on `node_runtime`.
export post_message := (worker, msg, transfer) ~> do {
  node := node_runtime()
  if transfer == null {
    js_invoke(worker, "postMessage", [msg], [], "void", false)
  } else if node == true {
    js_invoke(worker, "postMessage", [msg, transfer], [], "void", false)
  } else {
    js_invoke(worker, "postMessage", [msg, { transfer: transfer }], [], "void", false)
  }
}

--- Terminate `worker` (`worker.terminate`) — discards the worker
--- immediately, pending messages are dropped.
export terminate := (worker) ~>
  js_invoke(worker, "terminate", [], [], "void", false)

--- Register `arrow` for the worker's `"message"` events.
--- @details
--- Works on both worker shapes `spawn` can return: browser `Worker`
--- (an EventTarget — the arrow receives `MessageEvent.data`) and
--- Node `worker_threads` `Worker` (an EventEmitter — the arrow
--- receives the posted value directly; `js.on` feature-detects
--- `addEventListener` vs `on`/`off`). The arrow's resolved value —
--- when neither `null` nor `undefined` — is posted back to the worker
--- automatically (the `js.on` reply convention), so request/reply
--- handlers need no explicit `post_message` call. Returns the JS
--- listener for `off`.
export on_message := (worker, arrow) ~>
  js_on(worker, "message", arrow)

--- Worker-side counterpart of `on_message`: register `arrow` on the
--- worker-side message peer's `"message"` events — `self` on web
--- hosts, `parentPort` on Node (see `self_target`). The arrow's
--- non-null result is posted back to the parent automatically (the
--- `js.on` reply convention — `self`/`parentPort` are both `isPeer`
--- targets).
export on_message_self := (arrow) ~>
  js_on(self_target(), "message", arrow)

--- Register `arrow` for the worker's `"error"` events (uncaught
--- exceptions inside the worker). The arrow receives the `ErrorEvent`
--- on DOM targets, the `Error` itself on EventEmitters.
export on_error := (worker, arrow) ~>
  js_on(worker, "error", arrow)

--- Register `arrow` for the worker's `"messageerror"` events (a
--- message that could not be deserialized).
export on_message_error := (worker, arrow) ~>
  js_on(worker, "messageerror", arrow)

--- Worker-side counterpart of `on_error`: register `arrow` on the
--- worker-side peer's `"error"` events (`self` on web, `parentPort`
--- on Node).
export on_error_self := (arrow) ~>
  js_on(self_target(), "error", arrow)

--- Worker-side counterpart of `on_message_error`: register `arrow` on
--- the worker-side peer's `"messageerror"` events (`self` on web,
--- `parentPort` on Node).
export on_message_error_self := (arrow) ~>
  js_on(self_target(), "messageerror", arrow)

--- Register `arrow` for any DOM event on `target` (an EventTarget or
--- EventEmitter value, or a global name string like `"document"`/
--- `"self"`). Non-`"message"` events deliver the Event object itself
--- (DOM) or the emitter's first argument (emitter) to the arrow.
--- Returns the JS listener for `off`.
export on := (target, event, arrow) ~>
  js_on(target, event, arrow)

--- Remove a listener previously returned by `on`/`on_message`/
--- `on_message_self`.
export off := (target, event, listener) ~>
  js_off(target, event, listener)

--- Worker-side `self.postMessage(msg)` — reply to the parent. The
--- peer is `self_target`: the `self` global on web hosts, Node's
--- `worker_threads.parentPort` on Node (Node `worker_threads` has no
--- `self` global — the `MessagePort` is the real channel).
--- `transfer` is the optional transfer list; same web/Node split as
--- `post_message` (options record vs bare array). `js.invoke` is used
--- for the object peer and `js.call` for the `"self"` global name —
--- `invoke` does not resolve string targets.
export self_post_message := (msg, transfer) ~> do {
  node := node_runtime()
  t := self_target()
  args := if transfer == null {
    [msg]
  } else if node == true {
    [msg, transfer]
  } else {
    [msg, { transfer: transfer }]
  }
  if t == "self" {
    js_call("self", "postMessage", args, [], "void", false)
  } else if t == null {
    null
  } else {
    js_invoke(t, "postMessage", args, [], "void", false)
  }
}

--- Worker-side `self.close()` — stop the worker's event loop after
--- pending tasks drain. On Node `worker_threads` there is no
--- `self.close`; `process.exit(0)` ends the worker thread (the parent
--- observes the `"exit"` event).
export self_close := () ~> do {
  if node_runtime() == true {
    js_call("process", "exit", [0], [], "void", false)
  } else {
    js_call("self", "close", [], [], "void", false)
  }
}
