--- worker -- Web Worker bindings over the `js` interop ops.
---
--- Parent side: `spawn` constructs a `Worker` through `js.construct`,
--- `post_message`/`terminate` dispatch through `js.invoke`, and
--- `on_message` registers a Handl arrow for the worker's `"message"`
--- events — the `js.on` trampoline unwraps `MessageEvent.data`, awaits
--- the arrow, and posts a non-null result back to the worker.
---
--- NOTE: sdkgen now emits the dispatch forms this module hand-rolls —
--- `handl-packages/generated/html*/Worker_c.hnl` (and
--- `DedicatedWorkerGlobalScope_c.hnl`, `SharedWorker_c.hnl`,
--- `MessagePort_c.hnl`, `BroadcastChannel_c.hnl`, …) carry
--- `js.construct`/`js.invoke`/`js.on` adapters with `Result<_, JsError>`
--- returns and an explicit `self: Handle` receiver. This module stays
--- the ergonomic `js/worker` surface because the generated bindings do
--- NOT cover: `spawn_code`/`revoke_object_url` (Blob + object-URL
--- composition), the `on`/`off` generic event helpers, the
--- null-return + `js.error()` convention, or the worker-side `self`
--- global resolved by name (`self_post_message`/`on_message_self`/
--- `self_close` — the generated `DedicatedWorkerGlobalScope_*` ports
--- take `self` as an explicit Handle argument instead).
---
--- Worker side (the compiled entry running inside a worker global
--- scope): `self_post_message` replies to the parent,
--- `on_message_self` handles incoming messages, and `self_close`
--- terminates the worker — `self` resolves to the
--- `DedicatedWorkerGlobalScope`.
---
--- Node.js shim: browsers/Deno/Bun expose `Worker` on `globalThis`;
--- Node keeps it in `worker_threads` only, so `js.construct` cannot
--- reach it. `spawn` runs `ensure_worker_global` first, which installs
--- `globalThis.Worker` once on Node. The js contract has no
--- property-read op and no expression-level dynamic import
--- (`__handl_rt.import` exists in the compile-js prelude but no `.hnl`
--- syntax produces `Op{import}` — only `stmt.import` does), so the
--- probe/install goes through `eval` (`js.call("", "eval", …)` reaches
--- `globalThis.eval` via the bare-global fallback). A real `js.get`/
--- `js.set` pair plus a reachable import op would let this drop the
--- eval strings — tracked as the needed prelude/contract shim.
---
--- Transfer lists: `post_message`/`self_post_message` take an optional
--- `transfer` array. WebIDL `postMessage(message, options)` carries it
--- as `{ transfer: [...] }` (StructuredSerializeOptions); Node's
--- `worker_threads` `postMessage(value, transferList)` wants the bare
--- array, so the call branches on the Node probe.
---
--- Import as `from "js/worker" import { spawn, post_message, … }`
--- (the `js = { path = "…/lib-js/src" }` dep already covers it) or via
--- a `worker = { path = "…/lib-js/src/worker" }` dep.
---
--- Failure convention: every op returns `null` and records the JS
--- exception for `js.error()` when `throws` is false — check
--- `error()` after a `null` result exactly as with `js.call`.

from "js" import {
  await as js_await,
  call as js_call,
  construct as js_construct,
  error as js_error,
  invoke as js_invoke,
  off as js_off,
  on as js_on,
}

--- True on Node.js (`process.versions.node` is set). Probed via `eval`
--- because the js contract exposes no global property read — `call`'s
--- bare-global fallback reaches `globalThis.eval`, and indirect eval
--- sees the real global scope on every host.
node_runtime := () ~>
  js_call("", "eval",
    ["typeof process !== 'undefined' && !!(process.versions && process.versions.node)"],
    [], "js_boolean", false)

--- Ensure `globalThis.Worker` resolves. Browsers/Deno/Bun already
--- expose it (returns `true` without touching anything); on Node the
--- `worker_threads` export is installed once — synchronously via
--- `process.getBuiltinModule` (Node ≥ 20.16 / ≥ 22.3), falling back to
--- an awaited dynamic `import('worker_threads')`. Returns whether
--- `Worker` is a global afterwards; `false` on non-Node hosts without
--- it or when the install fails.
ensure_worker_global := () ~> do {
  has := js_call("", "eval", ["typeof Worker !== 'undefined'"], [], "js_boolean", false)
  node := node_runtime()
  if has == true {
    true
  } else if node != true {
    false
  } else {
    ok := js_call("", "eval", [
      "(function(){try{if(typeof process.getBuiltinModule==='function'){var m=process.getBuiltinModule('worker_threads');if(m&&m.Worker){globalThis.Worker=m.Worker;return true}}}catch(e){}return false})()"
    ], [], "js_boolean", false)
    if ok == true {
      true
    } else {
      p := js_call("", "eval", [
        "(async function(){try{var m=await import('worker_threads');if(m&&m.Worker){globalThis.Worker=m.Worker;return true}}catch(e){}return false})()"
      ], [], "js_object", false)
      js_await(p)
    }
  }
}

--- Spawn a `Worker` for `url` (a script URL — `blob:` URLs from
--- `spawn_code` work too).
--- @details
--- `opts` is the WebIDL `WorkerOptions` record (`{ type: "module",
--- name: "…" }`); pass `null` for the defaults. Returns the Worker
--- object, or `null` with `js.error()` set on failure (e.g. a
--- cross-origin URL the CSP refuses).
export spawn := (url, opts) ~> do {
  _ := ensure_worker_global()
  if opts == null {
    js_construct("", "Worker", [url], [], "js_object", false)
  } else {
    js_construct("", "Worker", [url, opts], [], "js_object", false)
  }
}

--- Spawn a `Worker` from inline `code` via a `Blob` object URL.
--- @details
--- Builds `new Blob([code])`, resolves `URL.createObjectURL`, and
--- delegates to `spawn`. The object URL is NOT revoked automatically —
--- call `revoke_object_url` once the worker has loaded if the code is
--- large or spawned repeatedly. Returns the Worker object or `null`
--- (with `js.error()` set) on failure.
export spawn_code := (code, opts) ~> do {
  blob := js_construct("", "Blob", [[code]], [], "js_object", false)
  e1 := js_error()
  url := if e1 == null {
    js_call("URL", "createObjectURL", [blob], [], "js_string", false)
  } else { null }
  e2 := js_error()
  if e2 == null { spawn(url, opts) } else { null }
}

--- Revoke an object URL minted by `spawn_code`/`URL.createObjectURL`.
export revoke_object_url := (url) ~>
  js_call("URL", "revokeObjectURL", [url], [], "void", false)

--- Post `msg` to `worker` (`worker.postMessage`).
--- @details
--- `transfer` is the optional structured-clone transfer list (a Handl
--- array of transferable objects — `ArrayBuffer`s, `MessagePort`s);
--- pass `null` for none. The message must be structured-cloneable:
--- Handl's `__pair__`/`__either__`/`__bytes__`/tag records survive the
--- clone, arrows/promises/`__resource__` handles do not.
--- On web hosts the list rides the WebIDL options record
--- (`postMessage(msg, { transfer })`); on Node `worker_threads` wants
--- the bare array (`postMessage(value, transferList)`), so the call
--- branches on `node_runtime`.
export post_message := (worker, msg, transfer) ~> do {
  node := node_runtime()
  if transfer == null {
    js_invoke(worker, "postMessage", [msg], [], "void", false)
  } else if node == true {
    js_invoke(worker, "postMessage", [msg, transfer], [], "void", false)
  } else {
    js_invoke(worker, "postMessage", [msg, { transfer: transfer }], [], "void", false)
  }
}

--- Terminate `worker` (`worker.terminate`) — discards the worker
--- immediately, pending messages are dropped.
export terminate := (worker) ~>
  js_invoke(worker, "terminate", [], [], "void", false)

--- Register `arrow` for the worker's `"message"` events.
--- @details
--- The arrow receives `MessageEvent.data` and its resolved value —
--- when neither `null` nor `undefined` — is posted back to the worker
--- automatically (the `js.on` reply convention), so request/reply
--- handlers need no explicit `post_message` call. Returns the JS
--- listener for `off`.
export on_message := (worker, arrow) ~>
  js_on(worker, "message", arrow)

--- Worker-side counterpart of `on_message`: register `arrow` on the
--- `self` global's `"message"` events. The arrow's non-null result is
--- posted back to the parent automatically.
export on_message_self := (arrow) ~>
  js_on("self", "message", arrow)

--- Register `arrow` for the worker's `"error"` events (uncaught
--- exceptions inside the worker). The arrow receives the `ErrorEvent`.
export on_error := (worker, arrow) ~>
  js_on(worker, "error", arrow)

--- Register `arrow` for the worker's `"messageerror"` events (a
--- message that could not be deserialized).
export on_message_error := (worker, arrow) ~>
  js_on(worker, "messageerror", arrow)

--- Worker-side counterpart of `on_error`: register `arrow` on the
--- `self` global's `"error"` events.
export on_error_self := (arrow) ~>
  js_on("self", "error", arrow)

--- Worker-side counterpart of `on_message_error`: register `arrow` on
--- the `self` global's `"messageerror"` events.
export on_message_error_self := (arrow) ~>
  js_on("self", "messageerror", arrow)

--- Register `arrow` for any DOM event on `target` (an EventTarget
--- value or a global name string like `"document"`/`"self"`).
--- Non-`"message"` events deliver the Event object itself to the
--- arrow. Returns the JS listener for `off`.
export on := (target, event, arrow) ~>
  js_on(target, event, arrow)

--- Remove a listener previously returned by `on`/`on_message`/
--- `on_message_self`.
export off := (target, event, listener) ~>
  js_off(target, event, listener)

--- Worker-side `self.postMessage(msg)` — reply to the parent.
--- `transfer` is the optional transfer list; same web/Node split as
--- `post_message` (options record vs bare array). Note Node
--- `worker_threads` has no `self` global — worker-side messaging there
--- goes through `parentPort`, which this module does not wrap yet.
export self_post_message := (msg, transfer) ~> do {
  node := node_runtime()
  if transfer == null {
    js_call("self", "postMessage", [msg], [], "void", false)
  } else if node == true {
    js_call("self", "postMessage", [msg, transfer], [], "void", false)
  } else {
    js_call("self", "postMessage", [msg, { transfer: transfer }], [], "void", false)
  }
}

--- Worker-side `self.close()` — stop the worker's event loop after
--- pending tasks drain.
export self_close := () ~>
  js_call("self", "close", [], [], "void", false)
