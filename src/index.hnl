--- js -- grades, types and arrows for JavaScript interop.
--- @details
--- `call` and `error` are injected by the JS runtime.
--- This package exposes the typed JS surface that SDK-generated adapters
--- import.

from "grade" import { Grade }
from "type" import { Obj }

--- Grade for JavaScript calls.
--- @details
--- Every arrow that calls a JS function or method carries the `JS` grade,
--- making the foreign effect visible to the type system.
export JS := Grade

--- JavaScript error value.
--- @details
--- This is the exception object thrown by the most recent failing JS call.
export JsError := Obj

--- Call a JS function or method immediately.
--- @details
--- `call` marshals the provided Handl values to JS according to the
--- descriptor strings, invokes the function, and unmarshals the return.
--- @param {obj} - JS global object or namespace name
--- @param {method} - method name on the object
--- @param {all_args} - Handl values to pass to the JS function
--- @param {descriptors} - marshalling descriptor for each argument and the return
--- @param {ret_kind} - return kind descriptor
--- @param {throws?} - if `true`, thrown exceptions are treated as errors
--- @returns {Value - the JS call's return, unmarshalled from `ret_kind`}
-- TODO(n-dim): effect row
export call: (String, String, Array, Array, String, Bool) ~[1]~> Value

--- Call a method on a receiver object.
--- @details
--- `invoke` is the receiver-aware counterpart of `call`: where `call`
--- names a global object or namespace, `invoke` dispatches `method` on
--- an object value obtained from an earlier call (a `Response`, a
--- `ReadableStream` reader, ...). Thrown exceptions are recorded for
--- `error`, exactly as `call` does. The sdkgen WebIDL adapters are
--- receiver-less today (`call("fetch", "text", [], ...)` dispatches with
--- no `this`), so hand-written adapters that need a method on a value
--- use `invoke` until the emitter passes the receiver through.
--- @param {receiver} - the JS object the method is dispatched on
--- @param {method} - method name on the receiver
--- @param {all_args} - Handl values to pass to the JS method
--- @param {descriptors} - marshalling descriptor for each argument and the return
--- @param {ret_kind} - return kind descriptor
--- @param {throws?} - if `true`, thrown exceptions are treated as errors
--- @returns {Value - the JS method's return, unmarshalled from `ret_kind`}
-- TODO(n-dim): effect row
export invoke: (Value, String, Array, Array, String, Bool) ~[1]~> Value

--- Read the most recent JS exception.
--- @details
--- This must be called synchronously, immediately after the failing JS
--- call whose error is being checked, before any other operation can
--- overwrite the stored exception.
--- @returns {JsError - the current JS exception}
-- TODO(n-dim): effect row
export error: () ~[1]~> JsError

--- Await a JS Promise.
--- @details
--- `await` resolves a promise produced by a `call` (fetch, Response
--- methods, timers, ...) and returns the settled value. The JS host owns
--- the event loop, so only it can settle a promise — this op is the
--- general interop bridge every Promise-returning API goes through, not
--- a fetch-specific hook.
--- @param {promise} - the Promise value returned by a previous `call`
--- @returns {Value - the resolved value, unmarshalled}
-- TODO(n-dim): effect row
export await: (Value) ~[1]~> Value

--- Construct a JS object with `new`.
--- @details
--- `construct` is the constructor counterpart of `call`: it resolves
--- `globalThis[obj][method]` — a dotted `method` path is walked from
--- the resolved base — falling back to `globalThis[method]` for bare
--- global constructors (`construct("", "Worker", …)` reaches
--- `globalThis.Worker`), then runs `Reflect.construct` — the emitted
--- `new Ctor(...args)` — with the same `error` capture convention as
--- `call`. sdkgen adapters are receiver-less and constructor-less
--- today, so hand-written bindings like `worker.spawn` go through
--- this op.
--- @param {obj} - JS global object or namespace name (`""` for globalThis)
--- @param {method} - constructor name or dotted path on the object
--- @param {all_args} - Handl values passed to the constructor
--- @param {descriptors} - marshalling descriptor for each argument and the return
--- @param {ret_kind} - return kind descriptor
--- @param {throws?} - if `true`, thrown exceptions are treated as errors
--- @returns {Value - the constructed JS object, unmarshalled from `ret_kind`}
-- TODO(n-dim): effect row
export construct: (String, String, Array, Array, String, Bool) ~[1]~> Value

--- Read a property on a JS object.
--- @details
--- `get` is the property-read counterpart of `invoke`: `target` is the
--- JS object value itself or a string naming a global (`"self"`,
--- `"window"`, `"process"`, `"globalThis"` — the same resolution `on`
--- applies); `key` is the property name or a dotted path walked from
--- the resolved object (`"gpu.requestAdapter"` reaches
--- `obj.gpu.requestAdapter` — the same walk `construct` applies to
--- `method`). The resolved value comes back raw — a thenable is boxed
--- like a `call`/`invoke` result so `js.await` settles it — while a
--- missing property (`undefined`) maps to `null`, and an unresolvable
--- receiver records `js.error()` and returns `null`. This is the
--- eval-free property read every shim needs (`globalThis.Worker`,
--- `el.value`, `navigator.gpu`).
--- @param {target} - JS object or global name string
--- @param {key} - property name or dotted path on the object
--- @returns {Value - the property value, or null on failure}
-- TODO(n-dim): effect row
export get: (Value, String) ~[1]~> Value

--- Write a property on a JS object.
--- @details
--- `set` is the property-write counterpart of `get`: it assigns
--- `target[key] = value` — `target` resolves exactly like `get` (an
--- object value or a string naming a global, so
--- `set("globalThis", "Worker", w)` installs the Node worker shim
--- without `eval`), and `key` is a property name or dotted path —
--- `set(o, "a.b", v)` walks to `o.a` and assigns `.b`. Returns the
--- assigned `value` so calls chain; a missing intermediate path or an
--- unresolvable receiver records `js.error()` and returns `null`.
--- @param {target} - JS object or global name string
--- @param {key} - property name or dotted path on the object
--- @param {value} - the value to assign
--- @returns {Value - the assigned value, or null on failure}
-- TODO(n-dim): effect row
export set: (Value, String, Value) ~[1]~> Value

--- Register a Handl arrow as a JS event listener.
--- @details
--- `on` is the JS→handl trampoline every callback-style JS API needs:
--- `arrow` — a compiled async `__in => …` Handl arrow — is wrapped in a
--- JS listener and registered via `target.addEventListener`. `target`
--- is the EventTarget value itself or a string naming a global
--- (`"self"`, `"window"`, `"document"`, …). For `"message"` events the
--- arrow receives `event.data` (the structured-cloned value — the
--- `__pair__`/`__either__`/`__bytes__`/tag records all survive the
--- clone); every other event receives the Event object itself. A
--- `"message"` handler whose arrow resolves to a non-null value gets
--- it posted back — `event.source` first, then the target's own
--- `postMessage` when the target is a message peer (a `Worker`, the
--- worker `self` global, a `MessagePort`) — so worker `onmessage`
--- replies need no extra plumbing; `null`/`undefined` results never
--- reply. Listener failures land in `error`, never as unhandled
--- rejections. Returns the JS listener for `off`.
--- @param {target} - EventTarget object or global name string
--- @param {event} - DOM event name (`"message"`, `"click"`, …)
--- @param {arrow} - Handl arrow receiving the event payload
--- @returns {Value - the registered JS listener, or null on failure}
-- TODO(n-dim): effect row
export on: (Value, String, Value) ~[1]~> Value

--- Remove a listener registered by `on`.
--- @details
--- `off` is the unregister counterpart of `on`: it resolves `target`
--- the same way and calls `removeEventListener` with the listener
--- value `on` returned.
--- @param {target} - EventTarget object or global name string
--- @param {event} - DOM event name the listener was registered under
--- @param {listener} - the JS listener value returned by `on`
--- @returns {Value - null on success, or the failure per `error`}
-- TODO(n-dim): effect row
export off: (Value, String, Value) ~[1]~> Value

--- Dynamically `import()` a module specifier.
--- @details
--- `import_module` is the eval-free dynamic-import op: it runs the JS
--- `import(spec)` — `import()` is syntax, not a member call, so `call`/
--- `invoke` cannot reach it — for specifiers like `"node:worker_threads"`,
--- `"./x.mjs"`, or a `data:` URL, and returns the module-namespace
--- promise boxed like a `call`/`invoke` result, so `await` settles it
--- into the usual `Result` (`ok` carries the namespace record, `err`
--- the rejection). This is what `js/worker`'s Node shim uses to reach
--- `worker_threads` without `eval`.
--- @param {spec} - the module specifier string
--- @returns {Value - a promise of the module namespace; settle with `await`}
-- TODO(n-dim): effect row
export import_module: (String) ~[1]~> Value
